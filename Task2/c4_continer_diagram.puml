@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title C4 Container Diagram - Target State (MVP) with Privacy by Design

' === Легенда ===
legend right
  | **Тип актора** | **Описание** |
  | Person | Внутренний пользователь (сотрудник) |
  | External Person | Внешний пользователь (пациент) |
endlegend

' === Акторы ВСЕГДА ВНЕ System_Boundary ===
Person(staff, "Медицинский персонал", "Врачи, ресепшен, кассиры. Используют внутренний портал")
Person_Ext(patient, "Пациент", "Внешний пользователь. Записывается на приём через ЛК/мобильное приложение")

' === Граница системы "Медикаменте" (ВНУТРИ — только контейнеры) ===
System_Boundary(medikamente, "Медикаменте (Целевая архитектура)") {
    
    ' --- Интеграционный слой (PEP) ---
    Container(api_gw, "API Gateway", "Java / Envoy", "Точка входа (PEP). Применяет политики маскирования PII и RBAC на лету")
    
    ' --- Порталы ---
    Container(patient_portal, "Patient Portal", "React / TypeScript", "Личный кабинет пациента (веб/мобильное)")
    Container(staff_portal, "Staff Portal", "React / TypeScript", "Портал для ресепшена и врачей")
    
    ' --- Ядро системы ---
    Container(core_app, "Core Medical App", "Java / Spring Boot", "Бизнес-логика: записи, приёмы, договоры. Soft Delete при отзыве согласия")
    Container(core_db, "Core Medical DB", "PostgreSQL", "Хранение ПДн и мед. карт. Row-Level Security (RLS) и шифрование столбцов")
    Container(payment_gateway, "Payment Gateway", "Java / Spring Boot", "Интеграция с ККМ и банками")

    ' --- Слой безопасности (PDP) ---
    Container_Boundary(security_boundary, "Слой управления безопасностью и комплаенсом") {
        Container(security_svc, "Security & Compliance Service", "Java / OPA", "PDP. Политики RBAC/ABAC, теги, согласия пациентов")
        Container(kms, "KMS", "HashiCorp Vault", "Управление криптографическими ключами")
    }
    
    ' --- Аналитический слой ---
    Container_Boundary(analytics_boundary, "Аналитический слой (Обезличенный)") {
        Container(etl, "ETL Pipeline", "Python / Airflow", "Псевдонимизация данных (ФИО → UUID) перед загрузкой")
        Container(analytics_db, "Secure Analytics DB", "ClickHouse", "Витрина обезличенных данных для BI/ML")
    }
    
    ' --- Управление жизненным циклом ---
    Container_Boundary(retention_boundary, "Управление жизненным циклом") {
        Container(retention_svc, "Retention Service", "Java / Cron", "Архивация данных и отложенное Crypto-Shredding")
        Container(archive_storage, "Cold Storage", "S3 / Encrypted FS", "Изолированное хранилище Legal Hold")
    }
}

' === Внешние системы (тоже ВНЕ System_Boundary) ===
System_Ext(lab, "Внешняя лаборатория", "Партнёрская система для интеграции анализов")
System_Ext(accounting_1c, "1С: Бухгалтерия", "Legacy, файловый режим")
System_Ext(warehouse_1c, "1С: Торговля и склад", "Legacy, файловый режим")
System_Ext(mail_server, "Exchange Mail Server", "Внутренняя почта")
System_Ext(kkm, "ККМ", "Контрольно-кассовые машины")

' === Взаимодействия: Акторы → Система ===
Rel(patient, patient_portal, "Запись на приём, просмотр ЛК", "HTTPS")
Rel(staff, staff_portal, "Ведение приёмов, учёт пациентов", "HTTPS")

' === Порталы → API Gateway ===
Rel(patient_portal, api_gw, "REST API", "HTTPS / mTLS")
Rel(staff_portal, api_gw, "REST API", "HTTPS / mTLS")

' === PEP ↔ PDP ===
Rel(api_gw, security_svc, "Запрос политик доступа", "gRPC")
Rel(core_app, security_svc, "Проверка прав (RLS)", "gRPC")

' === Внутри ядра ===
Rel(api_gw, core_app, "Проксирование запросов", "REST")
Rel(core_app, core_db, "Чтение/запись", "JDBC")
Rel(core_app, payment_gateway, "Инициация платежа", "REST")
Rel(payment_gateway, kkm, "Фискализация", "TCP/IP / OLE")

' === Аналитика ===
Rel(core_db, etl, "Выгрузка (CDC/Batch)", "Internal")
Rel(etl, analytics_db, "Загрузка обезличенных данных", "JDBC")

' === Retention ===
Rel(core_app, retention_svc, "Триггер архивации", "Internal API")
Rel(retention_svc, archive_storage, "Перенос в Cold Storage", "S3 API")
Rel(retention_svc, kms, "Уничтожение ключей", "KMS API")

' === Внешние интеграции ===
Rel(api_gw, lab, "Обмен анализами (фильтрация PII)", "REST / mTLS")
Rel(core_app, accounting_1c, "Финансовые данные", "SOAP / REST")
Rel(core_app, warehouse_1c, "Списание ТМЦ", "SOAP / REST")
Rel(core_app, mail_server, "Уведомления", "SMTP")

@enduml