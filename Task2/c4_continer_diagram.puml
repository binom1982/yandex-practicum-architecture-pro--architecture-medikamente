@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title C4 Container Diagram - Target State (MVP) with Privacy by Design

' === Легенда ===
legend right
  | **Тип актора** | **Описание** |
  | Person | Внутренний пользователь (сотрудник компании) |
  | External Person | Внешний пользователь (пациент, не является сотрудником) |
  | **Сокращения** | **Описание** |
  | PDP | Policy Decision Point (Принятие решений о доступе) |
  | PEP | Policy Enforcement Point (Применение решений: маскирование, проверка прав) |
  | PII | Personally Identifiable Information (Персональные данные) |
endlegend

' === Акторы (ВСЕГДА ВНЕ System_Boundary) ===
Person_Ext(patient, "Пациент", "Внешний пользователь. Записывается на приём через ЛК/мобильное приложение")
Person(staff_reception, "Сотрудник ресепшена", "Ведет журнал записей, заключает контракты")
Person(doctor, "Медицинский специалист", "Врач. Ведет приём, заполняет медицинские карты")
Person(cashier, "Кассир", "Принимает платежи, ведет учёт")
Person(accountant, "Бухгалтер", "Процессинг платежей, кадровый и налоговый учёт")
Person(warehouse_keeper, "Сотрудник склада", "Учёт ТМЦ и закупок оборудования")

' === Граница новой разрабатываемой системы ===
System_Boundary(medikamente_new, "Медикаменте (Целевая архитектура, To-Be)") {
    
    ' --- 1. Интеграционный слой (PEP) ---
    Container(api_gw, "API Gateway", "Java / Envoy", "Единая точка входа (PEP). Применяет политики маскирования PII и RBAC на лету, скрывает чувствительные поля во внешних ответах")
    
    ' --- 2. Порталы и Ядро системы ---
    Container(patient_portal, "Patient Portal", "React / TypeScript", "Личный кабинет пациента (веб/мобильное приложение)")
    Container(staff_portal, "Staff Portal", "React / TypeScript", "Портал для ресепшена и врачей")
    Container(core_app, "Core Medical App", "Java / Spring Boot", "Бизнес-логика: записи, приёмы, договоры. Выступает как PEP: запрашивает права у Security Service перед выполнением операций")
    Container(core_db, "Core Medical DB", "PostgreSQL", "Хранение ПДн и мед. карт. Использует Row-Level Security (RLS) и шифрование чувствительных столбцов (at rest)")
    Container(payment_gateway, "Payment Gateway", "Java / Spring Boot", "Интеграция с ККМ и банками. Обеспечивает безопасную обработку платежей")

    ' --- 3. Слой управления безопасностью и комплаенсом (PDP) ---
    Container_Boundary(security_boundary, "Слой управления безопасностью и комплаенсом") {
        Container(security_svc, "Security & Compliance Service", "Java / Open Policy Agent (OPA)", "PDP. Хранит политики доступа (RBAC/ABAC), теги конфиденциальности и статусы согласий пациентов на обработку ПДн")
        Container(kms, "KMS", "HashiCorp Vault", "Управление криптографическими ключами для шифрования и отложенного Crypto-Shredding")
    }
    
    ' --- 4. Аналитический слой (Privacy by Design) ---
    Container_Boundary(analytics_boundary, "Аналитический слой (Обезличенный)") {
        Container(etl, "ETL / Data Masking Pipeline", "Python / Airflow", "Извлекает данные из Core DB, применяет псевдонимизацию (замена ФИО на UUID, сдвиг дат) перед загрузкой")
        Container(analytics_db, "Secure Analytics DB", "ClickHouse", "Витрина обезличенных данных для BI и ML. Не содержит прямых идентификаторов (PII)")
    }
    
    ' --- 5. Слой управления жизненным циклом данных ---
    Container_Boundary(retention_boundary, "Управление жизненным циклом данных") {
        Container(retention_svc, "Retention & Archiving Service", "Java / Cron", "Переносит данные в Cold Storage по истечении срока и инициирует уничтожение ключей в KMS")
        Container(archive_storage, "Cold Storage Archive", "S3 / Encrypted FS", "Изолированное хранилище для Legal Hold (данные, которые нельзя удалить по закону, но доступ к которым ограничен)")
    }
}

' === Существующая ИТ-инфраструктура компании (Legacy) ===
System_Boundary(legacy_boundary, "Существующая ИТ-инфраструктура Медикаменте (Legacy)") {
    System_Ext(accounting_1c, "1С: Бухгалтерия", "Legacy, файловый режим. Учёт платежей, зарплаты, налогов")
    System_Ext(warehouse_1c, "1С: Торговля и склад", "Legacy, файловый режим. Учёт ТМЦ")
    System_Ext(mail_server, "Exchange Mail Server", "Внутренняя почта и отправка уведомлений")
    System_Ext(kkm, "ККМ", "Контрольно-кассовые машины для фискализации платежей")
}

' === Истинно внешние системы ===
System_Ext(lab, "Внешняя лаборатория", "Партнёрская система для интеграции результатов анализов по API")

' === Взаимодействия: Акторы → Система ===
Rel(patient, patient_portal, "Запись на приём, просмотр ЛК", "HTTPS")
Rel(staff_reception, staff_portal, "Регистрация пациентов, управление расписанием", "HTTPS")
Rel(doctor, staff_portal, "Ведение приёмов, просмотр и заполнение мед. карт", "HTTPS")
Rel(cashier, payment_gateway, "Обработка платежей", "HTTPS")
Rel(accountant, accounting_1c, "Ведение бухгалтерского и налогового учёта", "Локальная сеть")
Rel(warehouse_keeper, warehouse_1c, "Учёт ТМЦ и оформление закупок", "Локальная сеть")

' === Взаимодействия: Порталы → API Gateway (PEP) ===
Rel(patient_portal, api_gw, "REST API запросы", "HTTPS / mTLS")
Rel(staff_portal, api_gw, "REST API запросы", "HTTPS / mTLS")

' === Взаимодействия: PEP ↔ PDP (Безопасность) ===
Rel(api_gw, security_svc, "Запрос политик маскирования и доступа", "gRPC")
Rel(core_app, security_svc, "Запрос на авторизацию бизнес-действия (Check Access)", "gRPC")

' === Взаимодействия: Внутри ядра системы ===
Rel(api_gw, core_app, "Проксирует запросы после применения политик", "REST")
Rel(core_app, core_db, "Чтение/запись данных (с применением RLS на стороне БД)", "JDBC + TLS")
Rel(core_app, payment_gateway, "Инициация платежа", "REST")
Rel(payment_gateway, kkm, "Фискализация платежей", "TCP/IP / OLE")

' === Взаимодействия: Аналитика (Privacy by Design) ===
Rel(core_db, etl, "Выгрузка данных для аналитики (CDC/Batch)", "Internal")
Rel(etl, analytics_db, "Загрузка псевдонимизированных данных", "JDBC")

' === Взаимодействия: Управление жизненным циклом (Retention) ===
Rel(core_app, retention_svc, "Триггер на архивацию (смена статуса на CONSENT_REVOKED)", "Internal API")
Rel(retention_svc, archive_storage, "Перенос в изолированное хранилище (Legal Hold)", "S3 API")
Rel(retention_svc, kms, "Запрос/уничтожение ключей (отложенный Crypto-Shredding)", "KMS API")

' === Взаимодействия: Внешние интеграции ===
Rel(api_gw, lab, "Обмен результатами анализов (строгая фильтрация PII)", "REST API / mTLS")
Rel(core_app, accounting_1c, "Передача финансовых данных для учёта", "SOAP / REST")
Rel(core_app, warehouse_1c, "Списание ТМЦ по оказанным услугам", "SOAP / REST")
Rel(core_app, mail_server, "Отправка уведомлений пациентам и сотрудникам", "SMTP")

@enduml