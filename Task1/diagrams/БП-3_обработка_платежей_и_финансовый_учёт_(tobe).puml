@startuml БП-3_обработка_платежей_и_финансовый_учет
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Arial
top to bottom direction

skinparam actor {
    BackgroundColor White
    BorderColor Black
}
skinparam rectangle {
    BackgroundColor LightCoral
    BorderColor DarkRed
    RoundCorner 10
}
skinparam database {
    BackgroundColor LightYellow
    BorderColor Orange
    RoundCorner 10
}
skinparam arrow {
    Color DarkGray
    Thickness 2
}
skinparam note {
    BackgroundColor White
    BorderColor DarkGreen
    FontColor DarkGreen
}

actor "Пациент" as Patient
actor "Кассир" as Cassier
actor "Бухгалтер" as Bookkeeper

' ОРИГИНАЛЬНЫЕ НАЗВАНИЯ ПРОЦЕССОВ
rectangle "P3.1: Приём оплаты и фискализация" as P3_1
rectangle "P3.2: Двойной учёт платежей (Ручной + Автоматический)" as P3_2
rectangle "P3.3: Процессинг и сводный учёт" as P3_3

' ОРИГИНАЛЬНЫЕ НАЗВАНИЯ ХРАНИЛИЩ + АННОТАЦИИ МЕР ЗАЩИТЫ
database "DS6: ККМ\n(Фискальные данные)" as DS6
database "DS7: Excel-файл кассира\n(Дублирующий учёт)" as DS7
database "DS8: 1С:Бухгалтерия предприятия\n(Файловый режим)" as DS8

Patient -down-> P3_1 : "[FINANCE_MEDIUM] Денежные средства / Карта\n🔒 Должно использоваться: TLS 1.3 для эквайринга"
P3_1 -down-> DS6 : "Формирование чека"

Cassier -down-> P3_2 : "Ручной ввод данных об оплате\n🎭 Должно использоваться: Ограничение видимости ПДн пациента"
DS6 -up-> P3_2 : "[FINANCE_MEDIUM] Автоматическая передача (TCP/IP, OLE)\n🔒 Должно использоваться: Шифрование канала (замена на gRPC/mTLS)"
P3_2 -down-> DS7 : "[FINANCE_MEDIUM + PII_LOW] Запись в Excel\n❌ Должно использоваться: Устранение этого хранилища (отказ от двойного учёта)"
P3_2 -right-> DS8 : "[FINANCE_MEDIUM] Запись в 1С:Бухгалтерия\n🔒 Должно использоваться: Миграция на клиент-серверный режим с TDE"

Bookkeeper -down-> P3_3 : "Сверка, начисление ЗП, налоги"
DS8 -up-> P3_3 : "Выгрузка данных для отчётности\n🛡️ Должно использоваться: Аудит действий в СУБД"

note bottom of DS7
  **Мера защиты для этого потока/хранилища**: 
  Главная мера: ликвидация двойного учёта. 
  Если файл временно сохраняется, к нему должен 
  применяться sidecar-тег [FINANCE_MEDIUM] и DLP-контроль.
end note

note bottom of DS8
  **Мера защиты для этого потока/хранилища**: 
  Перевод из файлового режима в клиент-серверный 
  (PostgreSQL) для применения шифрования (TDE) 
  и разграничения прав (RLS) на уровне базы данных.
end note
@enduml