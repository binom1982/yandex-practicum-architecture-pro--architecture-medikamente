@startuml БП-1_регистрация_пациента_и_запись_на_приём
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Arial
top to bottom direction

skinparam actor {
    BackgroundColor White
    BorderColor Black
}
skinparam rectangle {
    BackgroundColor LightBlue
    BorderColor DarkBlue
    RoundCorner 10
}
skinparam database {
    BackgroundColor LightYellow
    BorderColor Orange
    RoundCorner 10
}
skinparam arrow {
    Color DarkGray
    Thickness 2
}
skinparam note {
    BackgroundColor White
    BorderColor DarkGreen
    FontColor DarkGreen
}

actor "Пациент" as Patient
actor "Администратор (Ресепшен)" as Admin

' ОРИГИНАЛЬНЫЕ НАЗВАНИЯ ПРОЦЕССОВ
rectangle "P1.1: Сбор и первичная обработка данных пациента" as P1_1
rectangle "P1.2: Формирование записи к специалисту" as P1_2

' ОРИГИНАЛЬНЫЕ НАЗВАНИЯ ХРАНИЛИЩ + АННОТАЦИИ МЕР ЗАЩИТЫ
database "DS1: Patients.xlsx\n(Список пациентов, ПДн)" as DS1
database "DS2: Journal-Doctor-FIO.xlsx\n(Журнал записей)" as DS2
database "DS3: Data file (JPG/PDF/Excel)\n(Скан-копии документов пациента)" as DS3

Patient -down-> P1_1 : "[PII_HIGH] ФИО, дата рождения, телефон, email\n🛡️ Должно использоваться: DLP-контроль ввода"
Admin -down-> P1_1 : "[PII_HIGH] Инициация регистрации, ввод данных\n🎭 Должно использоваться: Маскирование полей в UI"

P1_1 -down-> DS1 : "[PII_HIGH] Сохранение ПДн\n📎 Должно использоваться: Sidecar .json тег + 🔒 Шифрование диска"
P1_1 -down-> DS3 : "[MEDICAL_CRITICAL] Сохранение сканов документов\n📎 Должно использоваться: Sidecar .json тег + 🔒 Шифрование файла"

Admin -right-> P1_2 : "Выбор врача и времени"
P1_1 -right-> P1_2 : "[PII_HIGH] Передача идентификатора пациента\n🔒 Должно использоваться: Внутреннее шифрование канала"
P1_2 -down-> DS2 : "[PII_MEDIUM] Запись в журнал специалиста\n🛡️ Должно использоваться: Аудит изменений файла"

note bottom of DS1
  **Мера защиты для этого потока/хранилища**: 
  Внедрить автоматическое создание sidecar-файла 
  .classification.json с тегом [PII_HIGH]. 
  Ограничить доступ к папке через NTFS ACL.
end note

note bottom of DS3
  **Мера защиты для этого потока/хранилища**: 
  Применить шифрование файлов (at rest). 
  Настроить DLP-политику на блокировку отправки 
  файлов с тегом [MEDICAL_CRITICAL] за пределы сети.
end note
@enduml