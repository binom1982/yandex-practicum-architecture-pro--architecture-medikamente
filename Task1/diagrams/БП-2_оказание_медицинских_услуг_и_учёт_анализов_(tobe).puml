@startuml БП-2_оказание_медицинских_услуг_и_учет_анализов
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName Arial
top to bottom direction

skinparam actor {
    BackgroundColor White
    BorderColor Black
}
skinparam rectangle {
    BackgroundColor LightGreen
    BorderColor DarkGreen
    RoundCorner 10
}
skinparam database {
    BackgroundColor LightYellow
    BorderColor Orange
    RoundCorner 10
}
skinparam arrow {
    Color DarkGray
    Thickness 2
}
skinparam note {
    BackgroundColor White
    BorderColor DarkGreen
    FontColor DarkGreen
}

actor "Пациент" as Patient
actor "Врач (Специалист)" as Doctor
actor "Медицинская лаборатория\n(Внешняя система)" as Lab

rectangle "P2.1: Проведение консультации и постановка диагноза" as P2_1
rectangle "P2.2: Регистрация и обработка результатов анализов" as P2_2

database "DS4: Data file (Медицинская карта)\n(Диагнозы, заключения, JPG/PDF)" as DS4
database "DS5: Laboratory Registry / RegistryByDate.xlsx\n(Реестр анализов за день)" as DS5

Patient -down-> P2_1 : "[MEDICAL_CRITICAL] Жалобы, анамнез\nЗащищенный канал передачи"
Doctor -down-> P2_1 : "[MEDICAL_CRITICAL] Осмотр, формирование заключения\nRBAC и маскирование чужих записей"
P2_1 -down-> DS4 : "[MEDICAL_CRITICAL] Сохранение врачебной тайны\nSidecar .json тег + Шифрование файла"

Lab -down-> P2_2 : "[MEDICAL_CRITICAL] Передача результатов анализов\nШифрование канала (mTLS / VPN)"
Doctor -down-> P2_2 : "Направление на анализ"
P2_2 -down-> DS5 : "[PII_HIGH + MEDICAL_CRITICAL] Внесение данных в реестр Excel\nОбезличивание (псевдонимизация) перед аналитикой"
P2_2 -right-> DS4 : "[MEDICAL_CRITICAL] Прикрепление результатов к карте пациента"

note bottom of DS4
  <<To-Be>> Меры защиты:
  1. Обязательное тегирование файлов медицинских карт.
  2. Внедрение контроля целостности (хеширование) для 
     предотвращения несанкционированных изменений.
end note

note bottom of DS5
  <<To-Be>> Меры защиты:
  1. Принцип минимизации данных (Data Minimization).
  2. Автоматическая псевдонимизация (удаление или хеширование ФИО) 
     перед загрузкой реестра в аналитические системы (BI/ML).
end note
@enduml